{
  "manifest_version": 3,
  "name": "FeedCull — feed curation for the AI-slop era",
  "version": "0.1.1",
  "description": "Hide low-effort AI content from HN, Reddit and the web. Your feed, your rules: killfiles, author/domain reputation, topic filters, optional heuristic flags.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://news.ycombinator.com/*",
    "*://*.reddit.com/*",
    "*://old.reddit.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://news.ycombinator.com/*"],
      "js": ["src/heuristics.js", "src/content-core.js", "src/content-hn.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.reddit.com/*"],
      "js": ["src/heuristics.js", "src/content-core.js", "src/content-reddit.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "FeedCull"
  },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
